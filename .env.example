# Database (local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/fiveam?schema=public"

# Auth.js
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Magic-link email (optional). Leave EMAIL_SERVER_HOST empty to log links to the console in development.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="5am@localhost"
